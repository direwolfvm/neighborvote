# Local application (production: https://neighborvote.online)
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/neighborvote

# Platform administrators; other staff are scoped to communities in the application.
ADMIN_EMAILS=admin@example.com
# Generate unique values with: openssl rand -hex 48
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
MEMBER_SESSION_SECRET=replace-with-another-random-secret-at-least-32-characters
CRON_JOB_TOKEN=replace-with-a-random-token-at-least-32-characters

# Mailgun (use a domain sending key in production)
MAIL_PROVIDER=mailgun
MAIL_FROM="NeighborVote <no-reply@neighborvote.online>"
MAILGUN_API_KEY=key-xxxx
MAILGUN_DOMAIN=neighborvote.online
MAILGUN_API_BASE_URL=https://api.mailgun.net
# Local-only: Mailgun accepts test messages without delivering them. Set false in production.
MAILGUN_TEST_MODE=true
# Optional monitored reply inbox
# MAIL_REPLY_TO=community-manager@example.com

GCS_EXPORT_BUCKET=neighborvote-exports
