# App
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
CRON_JOB_TOKEN=replace-with-random-token

# Admin allowlist (comma-separated, case-insensitive)
ADMIN_EMAILS=admin@example.com
ADMIN_SESSION_SECRET=replace-with-32-plus-char-secret
MEMBER_SESSION_SECRET=replace-with-32-plus-char-secret

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/neighborvote

# Mail
MAIL_PROVIDER=postal
MAIL_FROM=no-reply@example.com
POSTAL_API_KEY=your-postal-server-api-key
POSTAL_API_URL=https://postal.neighborvote.online

# Legacy Mailgun/SendGrid (if MAIL_PROVIDER=mailgun or sendgrid)
# MAILGUN_API_KEY=key-xxxx
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_API_BASE_URL=https://api.mailgun.net

# Cloud Storage export target
GCS_EXPORT_BUCKET=neighborvote-exports
